---
import Layout from "../layouts/layout.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
---

<Layout title="No encontrado — NutriFind">
  <Header compact />
  <main class="mx-auto w-full max-w-3xl flex-1 px-4 py-16 text-center sm:px-6">
    <p class="label-mono">Error 404</p>
    <h1 class="mt-3 font-display text-4xl font-black uppercase leading-none tracking-tight sm:text-6xl">No encontramos esa página</h1>
    <p class="mt-4 text-lg">Puede que el producto ya no esté en el catálogo. Búscalo de nuevo o vuelve al inicio.</p>
    <a href="/" class="label-mono mt-6 inline-flex min-h-11 items-center bg-ink px-5 font-semibold text-paper">Ir al inicio</a>
  </main>
  <Footer />
</Layout>
