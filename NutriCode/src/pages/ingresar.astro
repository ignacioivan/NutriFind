---
import Layout from "../layouts/layout.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import LoginForm from "../components/login-form.tsx";
import { sanitizeRedirectPath } from "../lib/auth-validation.ts";

if (Astro.locals.user) {
  return Astro.redirect("/");
}

const redirectTo = sanitizeRedirectPath(Astro.url.searchParams.get("next"), "/");
const initialVerified = Astro.url.searchParams.get("verificado") === "1";
const rawEmail = (Astro.url.searchParams.get("correo") ?? "").trim().slice(0, 254);
---

<Layout title="Ingresar — NutriFind" description="Inicia sesión en NutriFind para acceder a tus productos y listas guardadas.">
  <Header compact />
  <main class="flex-1">
    <div class="mx-auto grid max-w-7xl items-start gap-8 px-4 py-8 sm:px-6 sm:py-12 lg:grid-cols-[1fr_1.05fr] lg:gap-12 lg:py-14">
      <section>
        <a href="/" class="label-mono inline-flex min-h-11 items-center font-semibold hover:underline underline-offset-4">
          ← Volver al catálogo
        </a>
        <div class="mt-4">
          <p class="label-mono inline-block bg-gold px-2 py-1 font-semibold">Acceso de usuario</p>
        </div>
        <h1 class="mt-3 font-display text-[clamp(2.25rem,5.5vw,3.5rem)] font-black uppercase leading-[0.92] tracking-tighter">
          Ingresa a tu <em class="bg-gold px-2 not-italic [box-decoration-break:clone]">cuenta</em>
        </h1>
        <p class="mt-4 max-w-md text-lg leading-relaxed">
          Retoma tus productos favoritos sin gluten y prepara tu próxima compra comparando precios.
        </p>

        <div class="mt-7 border-t border-ink pt-4">
          <p class="label-mono text-muted">¿Aún no tienes una cuenta?</p>
          <a
            href="/registro"
            class="label-mono mt-3 inline-flex min-h-11 items-center border-2 border-ink bg-white px-4 font-semibold hover:bg-ink hover:text-paper"
          >
            [ Crear cuenta gratis ]
          </a>
        </div>
      </section>

      <LoginForm
        client:load
        redirectTo={redirectTo}
        initialVerified={initialVerified}
        initialEmail={rawEmail}
      />
    </div>
  </main>
  <Footer note="No es obligatorio la creación de una cuenta para disfrutar del uso de la web." />
</Layout>
