---
import Layout from "../../layouts/layout.astro";
import Header from "../../components/header.astro";
import ProductGallery from "../../components/product-gallery.astro";
import StorePrices from "../../components/store-prices.astro";
import ProductGrid from "../../components/product-grid.astro";
import ErrorState from "../../components/error-state.astro";
import Footer from "../../components/footer.astro";
import SaveProductButton from "../../components/ui/save-product-button.astro";
import PriceHistoryChart from "../../components/ui/price-history-chart.tsx";
import { analyzeProductSpecs, formatCLP, formatDate } from "../../lib/format.ts";
import {
  DataError,
  getProduct,
  getProductPriceHistory,
  similarProducts,
  type PriceHistoryPoint,
  type Product,
} from "../../lib/products.ts";

const id = Number(Astro.params.id);
if (!/^\d+$/.test(Astro.params.id ?? "") || !Number.isSafeInteger(id)) return Astro.rewrite("/404");

let product: Product | null = null;
let similar: Product[] = [];
let priceHistory: PriceHistoryPoint[] = [];
let failed = false;
try {
  product = await getProduct(id);
  if (product) {
    [similar, priceHistory] = await Promise.all([
      similarProducts(product, 4),
      getProductPriceHistory(product),
    ]);
  }
} catch (e) {
  if (!(e instanceof DataError)) throw e;
  console.error(e.message);
  failed = true;
  Astro.response.status = 503;
}
if (!failed && !product) return Astro.rewrite("/404");
const specs = product ? analyzeProductSpecs(product.name, product.price) : null;
const folio = product ? `#${String(product.id).padStart(4, "0")}` : "";
---

<Layout
  title={product ? `${product.name} — ${formatCLP(product.price)} | NutriFind` : "NutriFind"}
  description={product ? `${product.name} (${product.brand}) a ${formatCLP(product.price)} en ${product.store}.` : undefined}
>
  <Header compact />
  <main class="flex-1">
    {
      !product || !specs ? (
        <ErrorState title="No pudimos cargar el producto" message="La base de datos no respondió. Intenta de nuevo en unos segundos." />
      ) : (
        <>
          {/* Barra superior de navegación y referencia (alinea el borde superior de ambas columnas) */}
          <div class="mx-auto flex max-w-7xl items-center justify-between px-4 pt-5 sm:px-6 lg:pt-8">
            <a href="/" data-back class="label-mono inline-flex min-h-10 items-center hover:underline">
              ← Volver
            </a>
            <span class="label-mono text-muted">
              Ficha de catálogo · {folio}
            </span>
          </div>

          <article class="mx-auto grid max-w-7xl gap-8 px-4 pt-3 pb-6 sm:px-6 lg:grid-cols-[1fr_1.12fr] lg:items-stretch lg:gap-10 lg:pb-10">
            {/* Columna izquierda: Galería de imagen + Historial de precios (bloque simétrico) */}
            <div class="flex flex-col gap-5">
              <ProductGallery images={product.images} alt={product.name} productId={product.id} />

              <PriceHistoryChart
                client:visible
                productId={product.id}
                productName={product.name}
                currentPrice={product.price}
                store={product.store}
                updatedAt={product.updatedAt}
                points={priceHistory}
                defaultExpanded={true}
              />
            </div>

            {/* Columna derecha: Encabezado + Precios por tienda + Información + Descripción editorial */}
            <div class="flex flex-col gap-5">
              <div>
                <p class="label-mono">{product.brand}{product.size && ` · ${product.size}`}</p>
                <h1 class="mt-2 font-display text-[clamp(1.75rem,3.8vw,2.65rem)] font-black leading-[1.03] tracking-tight">
                  {product.name}
                </h1>
                <div class="mt-3 flex flex-wrap items-center gap-3">
                  <p class="inline-block border-[1.5px] border-ink bg-gold px-2.5 py-1.5 text-sm font-black uppercase">
                    Sin gluten
                  </p>
                  <SaveProductButton productId={product.id} productName={product.name} variant="inline" />
                </div>
              </div>

              <StorePrices product={product} />

              <section class="border-2 border-ink bg-white" aria-labelledby="info-title">
                <div class="flex items-center justify-between border-b-8 border-ink px-3.5 py-2">
                  <h2 id="info-title" class="font-display text-lg font-black uppercase">
                    Información
                  </h2>
                  <span class="font-mono text-[10px] font-semibold uppercase text-muted">
                    Especificaciones
                  </span>
                </div>
                <dl class="grid grid-cols-[8.5rem_1fr] text-sm">
                  <dt class="label-mono flex items-center border-b border-r border-ink bg-paper/45 px-3.5 py-2 text-muted">
                    Marca
                  </dt>
                  <dd class="border-b border-ink px-3.5 py-2 font-semibold text-ink">
                    {product.brand}
                  </dd>
                  {product.size && (
                    <>
                      <dt class="label-mono flex items-center border-b border-r border-ink bg-paper/45 px-3.5 py-2 text-muted">
                        Contenido
                      </dt>
                      <dd class="border-b border-ink px-3.5 py-2 font-medium text-ink">
                        {product.size}
                      </dd>
                    </>
                  )}
                  <dt class="label-mono flex items-center border-b border-r border-ink bg-paper/45 px-3.5 py-2 text-muted">
                    Disponible
                  </dt>
                  <dd class="flex items-center gap-2 border-b border-ink px-3.5 py-2 font-medium text-ink">
                    <span class="inline-block size-2 border border-ink bg-best-price" aria-hidden="true" />
                    <span>Sí · En catálogo de {product.store}</span>
                  </dd>
                  <dt class="label-mono flex items-center border-r border-ink bg-paper/45 px-3.5 py-2 text-muted">
                    Actualizado
                  </dt>
                  <dd class="px-3.5 py-2 font-mono text-xs text-ink">
                    <time datetime={product.updatedAt}>{formatDate(product.updatedAt)}</time>
                  </dd>
                </dl>
              </section>

              <section class="flex flex-1 flex-col border-2 border-ink bg-white" aria-labelledby="desc-title">
                <div class="flex items-center justify-between gap-2 border-b-8 border-ink px-3.5 py-3">
                  <div>
                    <h2 id="desc-title" class="font-display text-lg font-black uppercase tracking-tight">
                      Descripción del producto
                    </h2>
                    <p class="mt-0.5 font-mono text-[11px] text-muted">
                      Resumen técnico · Desglose de formato y etiquetado
                    </p>
                  </div>
                  <span class="border border-ink bg-paper px-2 py-1 font-mono text-[10px] font-bold uppercase text-ink">
                    Etiqueta {folio}
                  </span>
                </div>

                {/* Bloque 1: Grilla superior de 3 celdas (espejo simétrico con KPIs de Historial) */}
                <div class="grid grid-cols-1 border-b-2 border-ink sm:grid-cols-3">
                  <div class="border-b border-ink p-3 sm:border-r sm:border-b-0">
                    <span class="block font-mono text-[10px] font-semibold uppercase text-muted">
                      Formato de venta
                    </span>
                    <span class="mt-0.5 block font-display text-lg font-black leading-tight text-ink">
                      {specs.formatValue}
                    </span>
                    <span class="mt-0.5 block font-mono text-[10px] text-muted">
                      {specs.formatSublabel}
                    </span>
                  </div>

                  <div class="border-b border-ink bg-[#fcfaf5] p-3 sm:border-r sm:border-b-0">
                    <span class="block font-mono text-[10px] font-semibold uppercase text-muted">
                      {specs.unitReferenceLabel}
                    </span>
                    <span class="mt-0.5 block font-display text-lg font-black tabular-nums leading-tight text-ink">
                      {specs.unitReferenceValue}
                    </span>
                    <span class="mt-0.5 block font-mono text-[10px] text-muted">
                      {specs.unitReferenceSublabel}
                    </span>
                  </div>

                  <div class="p-3">
                    <span class="block font-mono text-[10px] font-semibold uppercase text-muted">
                      Sellos de catálogo
                    </span>
                    <div class="mt-1 flex flex-wrap gap-1.5">
                      {specs.attributes.map((attr, idx) => (
                        <span
                          class:list={[
                            "border border-ink px-1.5 py-0.5 font-mono text-[10px] font-bold uppercase text-ink",
                            idx === 0 ? "bg-gold" : "bg-paper",
                          ]}
                        >
                          {attr}
                        </span>
                      ))}
                    </div>
                    <span class="mt-1 block font-mono text-[10px] text-muted">
                      Verificado en {product.store}
                    </span>
                  </div>
                </div>

                {/* Bloque 2: Cuerpo editorial con síntesis y fichas de lectura */}
                <div class="flex flex-1 flex-col justify-between gap-3.5 p-4">
                  <div class="border border-ink bg-[#fcfaf5] p-3.5 shadow-[3px_3px_0_#111111]">
                    <div class="border-l-[3px] border-gold pl-3">
                      <span class="block font-mono text-[10px] font-bold uppercase tracking-wider text-muted">
                        Síntesis del catálogo
                      </span>
                      <p class="mt-1 text-sm leading-relaxed text-ink">
                        <strong class="font-bold text-ink">{product.name}</strong> elaborado por{" "}
                        <strong class="font-bold text-ink">{product.brand}</strong>
                        {product.size ? ` en formato de ${product.size}` : ""}. Producto clasificado y auditado dentro del repertorio especializado de alimentos{" "}
                        <span class="border-b-2 border-gold font-semibold text-ink">libres de gluten</span> disponibles en{" "}
                        <strong class="font-bold text-ink">{product.store}</strong>.
                      </p>
                    </div>
                  </div>

                  <div class="grid grid-cols-1 gap-2.5 sm:grid-cols-2">
                    <div class="border border-ink bg-white p-2.5">
                      <span class="block font-mono text-[10px] font-bold uppercase text-ink">
                        01 · Referencia comparativa
                      </span>
                      <p class="mt-1 font-mono text-[11px] leading-snug text-muted">
                        Cálculo directo de <strong class="text-ink">{specs.unitReferenceValue}</strong> ({specs.formatSublabel.toLowerCase()}).
                      </p>
                    </div>
                    <div class="border border-ink bg-white p-2.5">
                      <span class="block font-mono text-[10px] font-bold uppercase text-ink">
                        02 · Trazabilidad de tienda
                      </span>
                      <p class="mt-1 font-mono text-[11px] leading-snug text-muted">
                        Ficha sincronizada con <strong class="text-ink">{product.store}</strong> el{" "}
                        <time datetime={product.updatedAt}>{formatDate(product.updatedAt)}</time>.
                      </p>
                    </div>
                  </div>
                </div>

                {/* Bloque 3: Pie de advertencia alimentaria (anclado al fondo para alinear el bloque) */}
                <div class="mt-auto flex items-center justify-between gap-2 border-t border-dashed border-ink bg-paper px-3.5 py-2 font-mono text-[11px] text-muted">
                  <span class="flex items-center gap-2">
                    <span
                      class="inline-flex size-4 shrink-0 items-center justify-center border border-ink bg-ink font-mono text-[10px] font-bold text-paper"
                      aria-hidden="true"
                    >
                      !
                    </span>
                    <span>
                      <strong class="font-bold uppercase text-ink">Aviso:</strong> Confirma certificación libre de trazas e ingredientes en el envase físico.
                    </span>
                  </span>
                </div>
              </section>
            </div>
          </article>

          {similar.length > 0 && (
            <section class="mx-auto max-w-7xl sm:px-6" aria-labelledby="similar-title">
              <h2 id="similar-title" class="border-t-[3px] border-ink px-4 pb-3 pt-6 font-display text-2xl font-black uppercase tracking-tight sm:px-0">
                Otros productos sin gluten similares
              </h2>
              <ProductGrid products={similar} compact />
            </section>
          )}
        </>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  // Coming from NutriFind, "Volver" goes back to the previous search instead of the home page.
  document.addEventListener("astro:page-load", () => {
    const back = document.querySelector<HTMLAnchorElement>("[data-back]");
    if (!back) return;
    // A new tab has no history to go back to, even if the referrer is NutriFind.
    const cameFromSite = history.length > 1 && (document.referrer.startsWith(location.origin) || (history.state?.index ?? 0) > 0);
    if (!cameFromSite) return;
    back.addEventListener("click", (e) => {
      e.preventDefault();
      history.back();
    });
  });
</script>
