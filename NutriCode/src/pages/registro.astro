---
import Layout from "../layouts/layout.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import RegisterForm from "../components/register-form.tsx";

if (Astro.locals.user) {
  return Astro.redirect("/");
}

const BENEFITS = [
  { code: "01", text: "Guarda tus productos frecuentes y revisa su precio actualizado." },
  { code: "02", text: "Guarda productos, creas listas y alista tus futuras compras." },
  { code: "03", text: "Filtra por tu prioridad alimentaria desde el primer ingreso." },
  { code: "04", text: "Sin costo y pensado para supermercados en Chile." },
] as const;
---

<Layout title="Crear cuenta — NutriFind" description="Crea tu cuenta gratis en NutriFind para guardar productos sin gluten y comparar precios.">
  <Header compact />
  <main class="flex-1">
    <div class="mx-auto grid max-w-7xl items-start gap-8 px-4 py-8 sm:px-6 sm:py-12 lg:grid-cols-[1fr_1.05fr] lg:gap-12 lg:py-14">
      <section>
        <a href="/" class="label-mono inline-flex min-h-11 items-center font-semibold hover:underline underline-offset-4">
          ← Volver al catálogo
        </a>
        <div class="mt-4">
          <p class="label-mono inline-block bg-gold px-2 py-1 font-semibold">Cuenta gratis</p>
        </div>
        <h1 class="mt-3 font-display text-[clamp(2.25rem,5.5vw,3.5rem)] font-black uppercase leading-[0.92] tracking-tighter">
          Guarda tus productos <em class="bg-gold px-2 not-italic [box-decoration-break:clone]">sin gluten</em>
        </h1>
        <p class="mt-4 max-w-md text-lg leading-relaxed">
          Crea tu cuenta en menos de un minuto para armar tu lista de compras y comparar precios entre supermercados.
        </p>

        <ul class="mt-7 border-t border-ink">
          {
            BENEFITS.map((item) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-3 border-b border-ink py-3.5 text-[0.95rem] leading-snug">
                <span class="label-mono font-semibold">{item.code}</span>
                <span>{item.text}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <RegisterForm client:load />
    </div>
  </main>
  <Footer note="No es obligatorio la creación de una cuenta para disfrutar del uso de la web." />
</Layout>
