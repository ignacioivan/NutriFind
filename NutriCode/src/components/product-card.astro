---
import type { Product } from "../lib/products.ts";
import { formatCLP, imageUrl } from "../lib/format.ts";
import SaveProductButton from "./ui/save-product-button.astro";

interface Props {
  product: Product;
  compact?: boolean;
  index?: number;
  deferLoad?: boolean;
}
const { product, compact = false, index = 0, deferLoad = false } = Astro.props;
const image = product.images[0];
const resolvedSrc = image ? imageUrl(image, 300) : "";
const colIndex = index % 4;
---

<div
  class="relative flex h-full flex-col"
  data-lazy-card={deferLoad ? "pending" : "ready"}
  data-col-index={colIndex}
>
  {/* Skeleton editorial "C · Etiqueta" mientras la tarjeta entra al umbral de 300px del scroll */}
  <div
    aria-hidden="true"
    class="nf-card-skeleton absolute inset-0 z-10 flex flex-col bg-paper p-3 sm:p-4"
  >
    <div class="nf-skeleton grid aspect-square w-full place-items-center border border-ink/25">
      <span class="font-mono text-[10px] font-semibold uppercase tracking-wider text-muted/70">
        Cargando...
      </span>
    </div>
    <div class="mt-3 flex items-center justify-between gap-2">
      <span class="nf-skeleton h-3 w-20 border border-ink/15" />
      <span class="nf-skeleton h-3 w-10 border border-ink/15" />
    </div>
    <div class="mt-2 mb-3 space-y-1.5">
      <div class="nf-skeleton h-3.5 w-full border border-ink/15" />
      <div class="nf-skeleton h-3.5 w-3/4 border border-ink/15" />
    </div>
    <div class="mt-auto flex items-baseline justify-between border-t-[6px] border-ink/25 pt-2">
      <span class="nf-skeleton h-6 w-24 border border-ink/15" />
      <span class="nf-skeleton h-3 w-12 border border-ink/15" />
    </div>
  </div>

  {/* Contenido real de la tarjeta */}
  <div class="nf-card-content relative flex h-full flex-col">
    <SaveProductButton productId={product.id} productName={product.name} variant="corner" />
    <a href={`/producto/${product.id}`} class="group flex h-full flex-col p-3 sm:p-4 focus-visible:outline-offset-[-3px]">
      <div class="relative grid aspect-square place-items-center overflow-hidden border border-ink bg-white" data-img-container>
        {
          image ? (
            <>
              <div
                data-img-skeleton
                aria-hidden="true"
                class="nf-skeleton absolute inset-0 grid place-items-center transition-opacity duration-200"
              >
                <span class="font-mono text-[10px] font-semibold uppercase tracking-wider text-muted/70">
                  NutriFind
                </span>
              </div>
              <span class="label-mono text-muted" aria-hidden="true" hidden>
                Sin imagen
              </span>
              <img
                src={deferLoad ? undefined : resolvedSrc}
                data-src={deferLoad ? resolvedSrc : undefined}
                alt=""
                width="300"
                height="300"
                loading="lazy"
                decoding="async"
                onload="this.style.opacity='1';if(this.previousElementSibling&&this.previousElementSibling.previousElementSibling){this.previousElementSibling.previousElementSibling.style.opacity='0';}"
                onerror="if(this.previousElementSibling){this.previousElementSibling.hidden=false;}if(this.previousElementSibling&&this.previousElementSibling.previousElementSibling){this.previousElementSibling.previousElementSibling.remove();}this.remove()"
                transition:name={`img-${product.id}`}
                style="opacity: 0;"
                class="absolute inset-0 size-full object-contain p-3 transition-[opacity,transform] duration-200 group-hover:scale-[1.03] motion-reduce:transition-none"
              />
            </>
          ) : (
            <span class="label-mono text-muted" aria-hidden="true">
              Sin imagen
            </span>
          )
        }
      </div>
      <p class="label-mono mt-3 flex justify-between gap-2 text-muted">
        <span class="truncate">{product.brand}</span>
        {product.size && <span class="shrink-0">{product.size}</span>}
      </p>
      <h3 class:list={["mt-1 mb-3 line-clamp-2 font-bold leading-snug group-hover:underline", compact ? "text-sm" : "text-[0.95rem]"]} title={product.name}>
        {product.name}
      </h3>
      <p class="mt-auto flex items-baseline justify-between border-t-[6px] border-ink pt-1.5">
        <span class:list={["font-black tabular-nums", compact ? "text-lg" : "text-2xl"]}>{formatCLP(product.price)}</span>
        <span class="label-mono">{product.store}</span>
      </p>
    </a>
  </div>
</div>
