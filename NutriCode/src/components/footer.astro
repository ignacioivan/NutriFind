---
interface Props {
  note?: string;
}
const { note = "Precios tomados de cada tienda. Confírmalos antes de comprar." } = Astro.props;
const isLocalDev = import.meta.env.DEV || Astro.url.hostname === "localhost" || Astro.url.hostname === "127.0.0.1";
---

<footer class="mt-auto border-t-[3px] border-ink">
  <div class="label-mono mx-auto flex max-w-7xl flex-col gap-1 px-4 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <span>NutriFind · Proyecto Capstone Duoc UC</span>
    <div class="flex flex-wrap items-center gap-4 text-muted">
      <span>{note}</span>
      {isLocalDev && (
        <a
          href="/archify/presentacion.html"
          class="font-semibold text-ink underline underline-offset-4 hover:text-gold"
        >
          [ Arquitectura & API Test ]
        </a>
      )}
    </div>
  </div>
</footer>
