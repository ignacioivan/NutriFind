---
import type { Product } from "../lib/products.ts";
import ProductCard from "./product-card.astro";

interface Props {
  products: Product[];
  compact?: boolean;
}
const { products, compact = false } = Astro.props;
---

<ul class="grid grid-cols-2 border-t border-ink lg:grid-cols-4">
  {
    products.map((product) => (
      <li class="border-b border-r border-ink [&:nth-child(2n)]:border-r-0 lg:[&:nth-child(2n)]:border-r lg:[&:nth-child(4n)]:border-r-0">
        <ProductCard product={product} compact={compact} />
      </li>
    ))
  }
</ul>
