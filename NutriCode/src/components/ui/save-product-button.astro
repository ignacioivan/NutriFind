---
interface Props {
  productId: number;
  productName: string;
  variant?: "corner" | "inline";
}

const { productId, productName, variant = "corner" } = Astro.props;
---

<button
  type="button"
  data-save-product-btn
  data-product-id={productId}
  data-product-name={productName}
  data-saved="false"
  data-just-saved="false"
  aria-label={`Guardar ${productName} en una lista`}
  aria-haspopup="dialog"
  class:list={[
    "group/save inline-flex min-h-10 cursor-pointer items-center border-2 border-ink bg-white px-2.5 py-1.5 text-ink shadow-[2px_2px_0_#111111]",
    "transition-[background-color,transform,box-shadow] delay-[40ms] duration-200 ease-[cubic-bezier(0.22,1,0.36,1)]",
    "hover:-translate-y-0.5 hover:bg-paper hover:shadow-[3px_3px_0_#111111] active:translate-y-0 active:shadow-none",
    "data-[saved=true]:bg-gold data-[saved=true]:hover:bg-gold",
    "data-[just-saved=true]:scale-105 data-[just-saved=true]:bg-gold",
    "motion-reduce:transition-none",
    variant === "corner" ? "absolute top-5 right-5 z-10 sm:top-6 sm:right-6" : "relative",
  ]}
>
  <!-- Texto lateral que se expande suavemente al pasar el mouse (hover) o siempre visible en ficha inline -->
  <span
    class:list={[
      "overflow-hidden whitespace-nowrap font-mono text-[11px] font-semibold uppercase tracking-tight",
      "transition-[max-width,opacity,margin] delay-75 duration-250 ease-[cubic-bezier(0.22,1,0.36,1)] motion-reduce:transition-none",
      variant === "corner"
        ? "mr-0 max-w-0 opacity-0 group-hover/save:mr-2 group-hover/save:max-w-36 group-hover/save:opacity-100 group-focus-visible/save:mr-2 group-focus-visible/save:max-w-36 group-focus-visible/save:opacity-100"
        : "mr-2 max-w-44 opacity-100",
    ]}
  >
    <span class="group-data-[saved=true]/save:hidden">Guardar producto</span>
    <span class="hidden group-data-[saved=true]/save:inline">Guardado</span>
  </span>

  <!-- Contenedor del icono con cambio animado entre Marcador y Visto (✓) -->
  <span class="relative inline-grid size-4.5 shrink-0 place-items-center" aria-hidden="true">
    <!-- Icono Marcador (Bookmark) -->
    <svg
      width="17"
      height="17"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="square"
      stroke-linejoin="miter"
      class="transition-all duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] group-data-[saved=true]/save:fill-ink group-data-[just-saved=true]/save:scale-0 group-data-[just-saved=true]/save:opacity-0 motion-reduce:transition-none"
    >
      <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
    </svg>

    <!-- Mini animación de Visto (✓) al guardar -->
    <svg
      width="17"
      height="17"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="square"
      stroke-linejoin="miter"
      class="absolute inset-0 m-auto scale-0 opacity-0 transition-all duration-200 ease-[cubic-bezier(0.34,1.56,0.64,1)] group-data-[just-saved=true]/save:scale-110 group-data-[just-saved=true]/save:opacity-100 motion-reduce:transition-none"
    >
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>
  </span>
</button>
