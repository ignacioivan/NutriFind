---
import { imageUrl } from "../lib/format.ts";

interface Props {
  images: string[];
  alt: string;
  productId: number;
}
const { images, alt, productId } = Astro.props;
const several = images.length > 1;
---

<div>
  <div class="flex snap-x snap-mandatory overflow-x-auto border-2 border-ink bg-white" tabindex={several ? 0 : undefined} aria-label={several ? "Fotos del producto" : undefined}>
    {
      images.length === 0 ? (
        <div class="label-mono grid aspect-square w-full place-items-center text-muted">Sin imagen</div>
      ) : (
        images.map((src, i) => (
          <img
            id={`foto-${i + 1}`}
            src={imageUrl(src, 800)}
            alt={several ? `${alt} — foto ${i + 1} de ${images.length}` : alt}
            width="800"
            height="800"
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : undefined}
            transition:name={i === 0 ? `img-${productId}` : undefined}
            onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'label-mono grid aspect-square w-full shrink-0 place-items-center text-muted',textContent:'Sin imagen'}))"
            class="aspect-square w-full shrink-0 snap-center object-contain p-6 sm:p-10"
          />
        ))
      )
    }
  </div>
  {
    several && (
      <ul class="mt-3 flex gap-2" aria-label="Elegir foto">
        {images.map((src, i) => (
          <li>
            <a href={`#foto-${i + 1}`} class="block size-14 border-[1.5px] border-ink bg-white p-1 hover:border-[3px]" aria-label={`Ver foto ${i + 1}`}>
              <img src={imageUrl(src, 120)} alt="" width="56" height="56" loading="lazy" class="size-full object-contain" />
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>
