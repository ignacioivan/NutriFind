---
interface Props {
  title: string;
  message: string;
}
const { title, message } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6" role="alert">
  <h1 class="font-display text-3xl font-black uppercase leading-none tracking-tight sm:text-5xl">{title}</h1>
  <p class="mt-4 text-lg">{message}</p>
  <a href="" class="label-mono mt-6 inline-flex min-h-11 items-center bg-ink px-5 font-semibold text-paper">Reintentar</a>
</section>
